# Maple environment template.
# Copy this to .env and fill in what you need. Everything below has a
# working default, so an empty .env is enough to run Maple locally as
# long as you set one of the two auth paths.

# --- Pick ONE auth path -----------------------------------------------

# (1) Google AI Studio key. Check which models its free tier covers and set
#     CHAT_MODEL to match (gemini-2.5-flash is a safe choice). Get one at
#     https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIzaYOUR_KEY_HERE

# (2) Vertex AI via gcloud Application Default Credentials. Skip this if
#     you're using GOOGLE_API_KEY above. Run first:
#     gcloud auth application-default login
#     gcloud config set project YOUR_PROJECT
#     gcloud services enable aiplatform.googleapis.com
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# Not every model is served from every region. The default models below
# (gemini-3.1-*) are served from `global` only, which means prompts may be
# processed outside Canada. For Canadian-only processing use
# CHAT_MODEL=gemini-2.5-flash and PRO_MODEL=gemini-2.5-pro with
# GOOGLE_CLOUD_LOCATION=northamerica-northeast1 (Montreal).
# northamerica-northeast2 (Toronto) serves neither family and answers
# 400 FAILED_PRECONDITION.

# --- Server --------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Shown in the UI footer, purely cosmetic.
DEPLOYMENT_REGION=local

# --- Agent -----------------------------------------------------------------
CHAT_MODEL=gemini-3.1-flash-lite
# The bigger model the Compare tab sets against CHAT_MODEL.
PRO_MODEL=gemini-3.1-pro-preview
# Tokens the model may spend thinking before it answers. 0 = off (fast).
# Try 1024 and watch the replies get slower.
THINKING_BUDGET=0
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_FALLBACK_MODEL=imagen-4.0-generate-001

# --- Session auth ------------------------------------------------------
# Signs the session cookie. Any long random string is fine locally; use a
# real one if you ever put this somewhere other people can reach.
SESSION_SECRET=replace-with-a-long-random-string

# Leave this FALSE. The shipped frontend has no UI for entering a
# per-visitor API key, so setting this to TRUE locks chat with no way to
# unlock it from the browser. FALSE means Maple opens one session per
# browser automatically using whichever auth path you set above.
REQUIRE_API_KEY=FALSE

# CORS: allowed origins as a JSON list. ["*"] is fine for local dev and for a
# single-purpose demo deployment.
CORS_ORIGINS=["*"]

# --- Optional: better web search -------------------------------------------
# Maple's web_search tool works with no keys at all (falls back to
# DuckDuckGo's Instant Answer API). Set either of these for noticeably
# better search results:

# Tavily - free tier at https://tavily.com
# TAVILY_API_KEY=tvly-...

# Google Programmable Search - https://programmablesearchengine.google.com
# GOOGLE_CSE_ID=your-search-engine-id
# (uses the same GOOGLE_API_KEY as above)

# --- Optional: admin page -----------------------------------------------
# Password for /admin (approve or deny queued orders). Defaults to 1234,
# which is fine for a classroom demo and not fine for anything else.
# ADMIN_PASSWORD=1234
